    "sections": [
      {
        "heading": "簡介",
        "items": [
          "以清熱為主要功效（裏熱、氣分、血分、虛實）",
          "藥性寒涼、味苦、傷脾胃、傷津液 ⇒ 寒清泄、苦清熱",
          "陰虛者可搭配養陰藥",
          "中病即止"
        ]
      },
      {
        "heading": "五大分類總覽",
        "subsections": [
          {
            "subheading": "清熱瀉火藥",
            "items": [
              "治氣分熱與臟腑熱氣",
              "症狀：①高熱 ②汗出 ③口渴 ④脈洪大有力",
              "現代藥理：解熱"
            ]
          },
          {
            "subheading": "清熱燥濕藥",
            "items": [
              "清濕熱證",
              "症狀：①濕溫、濕疹、濕痹 ②濕熱痢疾 ③黃疸 ④淋證",
              "現代藥理：利尿",
              "最容易傷陰"
            ]
          },
          {
            "subheading": "清熱解毒藥",
            "items": [
              "治熱毒證",
              "症狀：①瘡癰腫痛 ②痢疾 ③咽喉腫痛 ④溫熱病 ⑤燒燙傷",
              "現代藥理：抗腫瘤"
            ]
          },
          {
            "subheading": "清熱涼血藥",
            "items": [
              "治營分、血分熱證",
              "症狀：①斑疹 ②夜晚高熱 ③心煩不眠 ④出血、血熱妄行 ⑤抽搐、舌紫絳 ⑥脈細數"
            ]
          },
          {
            "subheading": "清虛熱藥",
            "items": [
              "治陰虛內熱",
              "症狀：①除骨蒸 ②退疳熱",
              "現代藥理：解熱"
            ]
          }
        ]
      }
