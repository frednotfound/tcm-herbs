[
  {
    "id": "cat_jiebiao",
    "category_path": "解表藥",
    "title": "解表藥概論",
    "source_page": [
      6
    ],
    "sections": [
      {
        "heading": "風邪",
        "subsections": [
          {
            "subheading": "內風",
            "items": [
              "肝風內動",
              "熱極生風",
              "肝陽化風",
              "陰虛風動",
              "血虛生風"
            ]
          },
          {
            "subheading": "外風",
            "items": [
              "由外而內，透過口鼻或肌表侵犯體內",
              "先犯肺系，或先侵肌表、經絡，若正氣虛弱則可內傳臟腑",
              "常見表證 ⇒ 怕風、發熱、頭痛"
            ]
          },
          {
            "subheading": "特性",
            "items": [
              "升發、向上、向外 ⇒ 鼻塞流涕、頭痛、頭暈、發熱、出汗",
              "風性善行而數變 ⇒ 不固定，病位可改變。發病急驟，病程多變",
              "主動，導致動搖表現 ⇒ 痙攣、抽搐",
              "百病之長，六淫之首 ⇒ 常見與其他邪氣並存"
            ]
          }
        ]
      },
      {
        "heading": "解表藥",
        "subsections": [
          {
            "subheading": "應用",
            "items": [
              "風寒證 ⇒ 溫裏藥（附子、乾薑）",
              "風熱證 ⇒ 清熱藥（金銀花、連翹）"
            ]
          },
          {
            "subheading": "使用注意事項",
            "items": [
              "中病即止 ⇒ 微似汗出為宜",
              "含揮發油 ⇒ 不宜久煎",
              "細辛、蒼耳子等具毒性 ⇒ 慎用"
            ]
          },
          {
            "subheading": "功效",
            "items": [
              "辛溫解表藥 ⇒ 發散風寒、驅風解表",
              "辛涼解表藥 ⇒ 發散風熱、清熱解表"
            ]
          },
          {
            "subheading": "性味歸經",
            "items": [
              "多為辛味 ⇒ 發散；部分兼苦味 ⇒ 清熱、燥濕",
              "多歸肺經 ⇒ 肺主皮毛；部分兼歸膀胱經"
            ]
          }
        ]
      }
    ]
  },
