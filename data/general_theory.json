  "harvesting": {
    "title": "中藥的採集",
    "source_page": [
      3
    ],
    "principles": [
      "藥材的有效成分與療效受生長環境影響極大 ⇒ 強調使用道地藥材",
      "植物藥材應在有效成分含量最高時採摘，不同部位與生長時期的有效成分含量有所差異 ⇒ 綿茵陳 vs 茵陳蒿"
    ],
    "by_part": [
      {
        "part": "果實與種子類",
        "rules": [
          "成熟時：瓜蔞、豆蔻",
          "未成熟：青皮"
        ]
      },
      {
        "part": "花類",
        "rules": [
          "正開放時：菊花、旋覆花",
          "含苞、花蕾時：金銀花、辛夷",
          "紅花：花冠由黃色變紅時",
          "蒲黃：花朵盛開時"
        ]
      },
      {
        "part": "葉類",
        "rules": [
          "花蕾將放時：枇杷葉"
        ]
      },
      {
        "part": "全草類",
        "rules": [
          "茂盛或開花時：益母草（地上部）、車前草（全株）"
        ]
      },
      {
        "part": "根莖類",
        "rules": [
          "春、秋：天麻、葛根",
          "夏季：半夏、延胡索"
        ]
      },
      {
        "part": "樹皮類",
        "rules": [
          "春末、夏季：杜仲",
          "秋後（根皮）：牡丹皮、地骨皮"
        ]
      }
    ]
  },
  "processing": {
    "title": "中藥炮製",
    "source_page": [
      3
    ],
    "purposes": [
      {
        "category": "去除非藥用部分",
        "items": [
          "淨選、清洗藥材以去除雜質（修製）",
          "種子類 ⇒ 去除沙土、雜質",
          "根類 ⇒ 去除蘆頭",
          "皮類 ⇒ 去除粗皮 eg. 杜仲、肉桂",
          "動物類 ⇒ 去除頭、足、翅等部位"
        ]
      },
      {
        "category": "便於調劑和製劑與儲藏",
        "items": [
          "藥物經乾燥處理 ⇒ 降低含水量",
          "含苷類藥物 ⇒ 加熱破壞酶活性 eg. 黃芩、杏仁（Baicalin --Enzyme--> Baicalein --[O]--> Baicalein quinone）",
          "動物類或有異味藥物 ⇒ 漂洗、酒製、醋製、蜜製"
        ]
      },
      {
        "category": "改變藥物性能及降低副作用",
        "items": [
          "降低毒性或副作用 ⇒ 草烏（Diester diterpenoid alkaloids）、相思子、蓖麻子、商陸、萱草根",
          "緩和藥性",
          "生熟不同作用 eg. 蒲黃",
          "增強藥物療效"
        ]
      }
    ],
    "methods": [
      {
        "category": "修製",
        "items": [
          "清除雜質、去除非藥用部位"
        ]
      },
      {
        "category": "水製",
        "items": [
          "潤、漂、水飛（礦物藥）"
        ]
      },
      {
        "category": "火製",
        "items": [
          "炒黃緩和藥性、種子炒後易釋放、炒碳止血、輔料炒增強療效、燙炒易水煎出有效成分",
          "煨、炙、煅"
        ]
      },
      {
        "category": "水火共製",
        "items": [
          "煮、蒸、淬、潬、發芽、發酵、製霜、複製"
        ]
      }
    ]
  },
